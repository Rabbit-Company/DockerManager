{
	"name": "dockermanager",
	"version": "0.2.0",
	"description": "Manage Docker and Podman hosts from one web interface: monitoring, compose stacks, image updates, encrypted backups, transfers, alerts and firewall",
	"type": "module",
	"license": "EUPL-1.2",
	"author": "Rabbit Company <info@rabbit-company.com>",
	"private": true,
	"scripts": {
		"dev": "bun --watch run src/controller/index.ts",
		"start": "bun run src/controller/index.ts",
		"agent": "bun run src/agent/index.ts",
		"build": "bun run scripts/build.ts",
		"migrate": "bun run src/controller/db/migrate.ts",
		"test": "bun test",
		"test:postgres": "TEST_DATABASE=postgres bun test",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\""
	},
	"dependencies": {
		"@codemirror/commands": "^6.11.2",
		"@codemirror/lang-yaml": "^6.1.3",
		"@codemirror/language": "^6.13.1",
		"@codemirror/lint": "^6.9.8",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.44.2",
		"@lezer/highlight": "^1.2.5",
		"@rabbit-company/qrcode": "^1.2.0",
		"@rabbit-company/totp": "^1.0.1",
		"@rabbit-company/web": "^0.21.0",
		"@rabbit-company/web-middleware": "^0.21.0",
		"chart.js": "^4.6.2",
		"chartjs-plugin-zoom": "^3.0.2",
		"codemirror": "^6.0.2",
		"nodemailer": "^10.6.1",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.6.1",
		"@electric-sql/pglite-socket": "^0.3.1",
		"@types/bun": "latest",
		"@types/nodemailer": "^8.0.2",
		"prettier": "^3.10.1",
		"typescript": "^7.0.2"
	}
}
