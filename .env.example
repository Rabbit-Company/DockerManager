# Address people and agents use to reach the controller. Join commands are built from it.
DOMAIN=https://docker.example.com
PORT=3000
BIND_ADDRESS=0.0.0.0
# direct, cloudflare, nginx, aws and the other presets of @rabbit-company/web-middleware/ip-extract
TRUST_PROXY=direct

# sqlite://./data/controller.sqlite (default) or postgres://user:password@host:5432/dockermanager
DATABASE_URL=sqlite://./data/controller.sqlite

# Required on the first run setup page. When empty, a random token is printed in the log.
SETUP_TOKEN=
SESSION_DAYS=14
JOIN_TOKEN_MINUTES=60
AGENT_REQUEST_TIMEOUT_MS=30000
# Folder with agent-linux-x64 and agent-linux-arm64, served to the install script
AGENT_DOWNLOADS=./dist
# How long metrics are kept: raw 10 second samples, minute averages, hourly averages
METRICS_RAW_HOURS=24
METRICS_MINUTE_DAYS=14
METRICS_HOUR_DAYS=365
# Image updates: hours between registry checks, plain HTTP registries, seconds a deploy waits for healthy containers
UPDATE_CHECK_HOURS=6
REGISTRY_INSECURE=
# Extra authentication origins for registries that use a separate token service.
# Example: registry.example.com=https://auth.example.com
REGISTRY_AUTH_REALMS=
HEALTH_TIMEOUT_SECONDS=120
# Key for stack .env files on the controller, 32 bytes in base64url. When empty, data/secret.key is created.
SECRETS_KEY=
SECRETS_KEY_FILE=./data/secret.key
LOG_LEVEL=3
# Time zone for backup schedules, job output and log times, such as Europe/Ljubljana. The system zone when empty.
TZ=
